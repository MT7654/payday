{
  "manifest_version": 3,
  "name": "Payday — Things that caught your eye",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "A thoughtful shortlist for your next payday. Review your interests and explore what would make your day.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Payday companion"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://payday-reward-discovery.maltoh12345.chatgpt.site/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
